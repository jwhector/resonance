{
  "name": "@resonance/weave-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "pnpm run corpus:check && tsc -p tsconfig.json",
    "corpus:compile": "tsx scripts/compile-corpus.ts",
    "corpus:check": "tsx scripts/compile-corpus.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@resonance/core": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@resonance/eslint-config": "workspace:*",
    "@resonance/tsconfig": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "eslint": "^9.18.0",
    "js-yaml": "^4.1.0",
    "tsx": "4.22.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
